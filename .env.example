# Supabase — hentes fra supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin
ADMIN_EMAIL=

# Valgfritt — brukes kun av `npm run set-admin-password` som engangs-oppsett.
# Slett etter bruk.
ADMIN_PASSWORD=

# Resend — hentes fra resend.com → API Keys
RESEND_API_KEY=

# OpenAI — hentes fra platform.openai.com → API keys. Brukes til AI-generert cover-bilde i admin,
# «Oversett med AI» i admin og `npm run translate-content` (norsk → engelsk).
OPENAI_API_KEY=
# Valgfritt: overstyr modellene (standard gpt-image-2 og gpt-5-mini)
OPENAI_IMAGE_MODEL=
OPENAI_TEXT_MODEL=

# Hemmelighet for POST /api/revalidate (import-skript og pg_cron). Lag en tilfeldig streng, legg samme verdi i Vercel og i Supabase Vault som revalidate_secret.
REVALIDATE_SECRET=

# App
NEXT_PUBLIC_SITE_URL=https://marcusjenshaug.no
